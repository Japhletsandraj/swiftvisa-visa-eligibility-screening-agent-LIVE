# LM Studio Configuration
# For local development, use your LM Studio instance:
# LM_STUDIO_BASE_URL=http://192.168.0.103:1234/v1
# 
# For Streamlit Cloud deployment, you have 2 options:
# 
# OPTION 1: Use a publicly accessible LM Studio endpoint (if you have one)
# LM_STUDIO_BASE_URL=https://your-public-lm-studio-endpoint/v1
#
# OPTION 2: Switch to OpenAI API (recommended for cloud deployment)
# See llm_integration.py to add OpenAI support

LM_STUDIO_BASE_URL=http://192.168.0.103:1234/v1
LM_STUDIO_MODEL=llama-3.2-3b-instruct
LM_STUDIO_TEMPERATURE=0.3
LM_STUDIO_MAX_TOKENS=500
LM_STUDIO_TOP_P=0.9
